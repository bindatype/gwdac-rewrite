{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://said.arc.gwu.edu/schemas/pion-photoproduction-amplitude-result-v1.json",
  "title": "CM12 Walker helicity-amplitude result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "code_version",
    "solution",
    "reaction",
    "dataset_version",
    "convention",
    "units",
    "records"
  ],
  "properties": {
    "contract_version": {
      "const": "pion-photoproduction-amplitude-v1"
    },
    "code_version": {
      "type": "string",
      "minLength": 1
    },
    "solution": {
      "const": "CM12"
    },
    "reaction": {
      "enum": [
        "pi0p",
        "pi+n",
        "pi-p",
        "pi0n"
      ]
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "convention": {
      "const": "legacy_choice_1_walker_vpi_su"
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle",
        "energy",
        "amplitude",
        "review_status"
      ],
      "properties": {
        "angle": {
          "const": "deg"
        },
        "energy": {
          "const": "MeV"
        },
        "amplitude": {
          "const": "mFm"
        },
        "review_status": {
          "const": "pending_domain_review"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 70,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "independent_variable",
          "independent_value",
          "a1",
          "a2",
          "a3",
          "a4"
        ],
        "properties": {
          "independent_variable": {
            "enum": [
              "acm_deg",
              "cos_acm",
              "photon_lab_energy_mev",
              "total_cm_energy_mev"
            ]
          },
          "independent_value": {
            "type": "number"
          },
          "a1": {
            "$ref": "#/$defs/complexAmplitude"
          },
          "a2": {
            "$ref": "#/$defs/complexAmplitude"
          },
          "a3": {
            "$ref": "#/$defs/complexAmplitude"
          },
          "a4": {
            "$ref": "#/$defs/complexAmplitude"
          }
        }
      }
    }
  },
  "$defs": {
    "complexAmplitude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real",
        "imaginary"
      ],
      "properties": {
        "real": {
          "type": "number"
        },
        "imaginary": {
          "type": "number"
        }
      }
    }
  }
}
