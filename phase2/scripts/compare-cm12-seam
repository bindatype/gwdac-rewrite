#!/usr/bin/env bash
set -euo pipefail

readonly phase2_root="${PHASE2_ROOT:-/phase2}"
readonly report_root="${PHASE2_REPORT_ROOT:-${phase2_root}/reports}"
readonly dsg_corpus="${phase2_root}/fixtures/corpus.tsv"
readonly amplitude_corpus="${phase2_root}/fixtures/amplitudes/corpus.tsv"
readonly comparison="${report_root}/cm12-seam-parity.tsv"
readonly markdown_report="${report_root}/cm12-seam-validation.md"
readonly dataset_manifest="${report_root}/cm12-kcm-dataset-manifest.tsv"
readonly loader_report="${report_root}/cm12-dataset-loader.tsv"
readonly build_manifest="${report_root}/cm12-seam-build-manifest.txt"
readonly scalar_parity="${report_root}/cm12-scalar-parity.tsv"
readonly solution_loader="${report_root}/cm12-solution-loader.tsv"
readonly layer_parity="${report_root}/cm12-layer-parity.tsv"
readonly pure_kernel_parity="${report_root}/cm12-pure-kernel-parity.tsv"

for required in \
    "${dsg_corpus}" \
    "${amplitude_corpus}" \
    "${dataset_manifest}" \
    "${loader_report}" \
    "${build_manifest}" \
    "${scalar_parity}" \
    "${solution_loader}" \
    "${layer_parity}" \
    "${pure_kernel_parity}" \
    "${report_root}/prsdd-corpus-modern.tsv" \
    "${report_root}/prsdd-corpus-seam.tsv" \
    "${report_root}/prsdd-amplitude-corpus-modern.tsv" \
    "${report_root}/prsdd-amplitude-corpus-seam.tsv"; do
    test -f "${required}"
done

printf '%s\n' \
    $'contract\tid\trows\tmodern_sha256\tseam_sha256\texact' \
    >"${comparison}"

dsg_cases=0
dsg_rows=0
while IFS=$'\t' read -r id category solution reaction independent_variable \
    grid_min grid_step grid_max fixed_variable fixed_value observable \
    expected_rows expected_behavior description; do
    if [[ "${id}" == "id" ]]; then
        continue
    fi
    modern="${report_root}/corpus/modern/${id}.results.tsv"
    seam="${report_root}/corpus/seam/${id}.results.tsv"
    test -f "${modern}"
    test -f "${seam}"
    cmp -s "${modern}" "${seam}"
    rows="$(($(wc -l <"${modern}") - 1))"
    dsg_cases=$((dsg_cases + 1))
    dsg_rows=$((dsg_rows + rows))
    printf '%s\t%s\t%s\t%s\t%s\tyes\n' \
        dsg \
        "${id}" \
        "${rows}" \
        "$(sha256sum "${modern}" | awk '{print $1}')" \
        "$(sha256sum "${seam}" | awk '{print $1}')" \
        >>"${comparison}"
done <"${dsg_corpus}"

amplitude_cases=0
amplitude_rows=0
while IFS=$'\t' read -r id category solution reaction independent_variable \
    grid_min grid_step grid_max fixed_variable fixed_value amplitude_choice \
    expected_rows expected_behavior description; do
    if [[ "${id}" == "id" ]]; then
        continue
    fi
    modern="${report_root}/amplitude-corpus/modern/${id}.results.tsv"
    seam="${report_root}/amplitude-corpus/seam/${id}.results.tsv"
    test -f "${modern}"
    test -f "${seam}"
    cmp -s "${modern}" "${seam}"
    rows="$(($(wc -l <"${modern}") - 1))"
    amplitude_cases=$((amplitude_cases + 1))
    amplitude_rows=$((amplitude_rows + rows))
    printf '%s\t%s\t%s\t%s\t%s\tyes\n' \
        amplitude \
        "${id}" \
        "${rows}" \
        "$(sha256sum "${modern}" | awk '{print $1}')" \
        "$(sha256sum "${seam}" | awk '{print $1}')" \
        >>"${comparison}"
done <"${amplitude_corpus}"

dataset_files="$(($(wc -l <"${dataset_manifest}") - 1))"
scalar_cases="$(($(wc -l <"${scalar_parity}") - 1))"
if [[ "${scalar_cases}" -ne 42 ]]; then
    printf 'Scalar parity report does not contain 42 evaluations\n' >&2
    exit 1
fi
if ! awk -F '\t' 'NR > 1 && $7 != "T" { exit 1 }' "${scalar_parity}"; then
    printf 'Scalar parity report is incomplete or contains a mismatch\n' >&2
    exit 1
fi
solution_records="$(awk -F '\t' 'NR == 2 { print $4 }' "${solution_loader}")"
solution_active_forms="$(
    awk -F '\t' 'NR == 2 { print $5 }' "${solution_loader}"
)"
solution_cm12_forms="$(
    awk -F '\t' 'NR == 2 { print $6 }' "${solution_loader}"
)"
solution_sha256="$(
    awk -F '\t' 'NR == 2 { print $3 }' "${solution_loader}"
)"
nonzero_born_cases="$(
    awk -F '\t' '
        $1 == "multipole" && ($4 + 0) != 0 { count++ }
        END { print count + 0 }
    ' "${layer_parity}"
)"
layer_cases="$(
    awk -F '\t' '$1 == "multipole" { count++ } END { print count + 0 }' \
        "${layer_parity}"
)"
prda_cases="$(
    awk -F '\t' '$1 == "prda" { count++ } END { print count + 0 }' \
        "${pure_kernel_parity}"
)"
dsg_kernel_cases="$(
    awk -F '\t' '$1 == "dsg" { count++ } END { print count + 0 }' \
        "${pure_kernel_parity}"
)"
if [[ "${solution_records}" -ne 54 ]] || \
    [[ "${solution_active_forms}" -ne 60 ]] || \
    [[ "${solution_cm12_forms}" -ne 34 ]]; then
    printf 'Solution loader report has unexpected CM12 dimensions\n' >&2
    exit 1
fi
if [[ "${layer_cases}" -ne 42 ]] || \
    [[ "${nonzero_born_cases}" -ne 42 ]]; then
    printf 'Nonzero-Born layer parity report is incomplete\n' >&2
    exit 1
fi
if ! awk -F '\t' 'NR > 1 && $5 != "T" { exit 1 }' "${layer_parity}"; then
    printf 'Layer parity report contains a mismatch\n' >&2
    exit 1
fi
if [[ "${prda_cases}" -ne 6 ]] || [[ "${dsg_kernel_cases}" -ne 3 ]]; then
    printf 'Pure PRDA/DSG report has unexpected case counts\n' >&2
    exit 1
fi
if ! awk -F '\t' 'NR > 1 && $3 != "T" { exit 1 }' \
    "${pure_kernel_parity}"; then
    printf 'Pure PRDA/DSG report contains a mismatch\n' >&2
    exit 1
fi
dataset_sha="$(sha256sum "${dataset_manifest}" | awk '{print $1}')"
comparison_sha="$(sha256sum "${comparison}" | awk '{print $1}')"
layer_sha="$(sha256sum "${layer_parity}" | awk '{print $1}')"
pure_kernel_sha="$(sha256sum "${pure_kernel_parity}" | awk '{print $1}')"
kernel_sha="$(
    awk '$2 == "/phase2/kernel/cm12_kernel.f90" { print $1 }' \
        "${build_manifest}"
)"
solution_kernel_sha="$(
    awk '$2 == "/phase2/kernel/cm12_solution.f90" { print $1 }' \
        "${build_manifest}"
)"
background_sha="$(
    awk '$2 == "/phase2/kernel/cm12_background_seam.f90" { print $1 }' \
        "${build_manifest}"
)"
adapter_sha="$(
    awk '$2 == "/phase2/kernel/cm12_prda_probs_seam.f90" { print $1 }' \
        "${build_manifest}"
)"

cat >"${markdown_report}" <<EOF
# CM12 solution, background, amplitude, and DSG seam validation

Generated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')

## Result

The explicit loader accepted exactly ${dataset_files} CM12 K-matrix files:
14 S/P/D/F partial waves with \`cmm\`, \`cmf\`, and \`kcm\` components.
Every file has 275 records on the common 1080-2450 MeV grid and the expected
record width. A missing dataset root is rejected with typed loader status 2.

The immutable solution loader read the four-character \`CM12\` record directly
from the surviving \`sdat/prsol.dat\` source after verifying SHA-256
\`${solution_sha256}\`. It recovered ${solution_records} explicit parameter
records, ${solution_active_forms} active physical forms, ${solution_cm12_forms}
CM12 form selectors, fixed isospin/helicity coefficients, and the six
background coupling values. A mismatched hash is rejected with status 5 and a
missing solution identifier with status 6.

The explicit background seam returns full Born multipoles, OPEC multipoles,
and four initial HOPEC amplitudes from immutable constants. An A-B-A sequence
returned exact first/third results, demonstrating order-independent seam
behavior for the retained calls.

The headless compatibility binary routes valid CM12 calculation state through
the immutable solution/dataset objects, explicit background seam, pure
\`PRDA\` accumulation, and pure DSG operation. It completed:

- ${dsg_cases} DSG cases and ${dsg_rows} typed records.
- ${amplitude_cases} choice-1 amplitude cases and ${amplitude_rows} typed
  records, each with four complex amplitudes.
- Exact byte equality with the modern frozen reference at displayed precision
  for all ${dsg_cases} DSG and ${amplitude_cases} amplitude cases.
- Exact single-precision scalar equality with legacy \`ysKCM\` for
  ${scalar_cases} direct evaluations spanning all 14 loaded waves at 1100,
  1500, and 1900 MeV Wcm with a synthetic zero Born contribution.
- Exact single-precision scalar equality for ${layer_cases} actual CM12
  solution evaluations with ${nonzero_born_cases} nonzero Born contributions.
- Exact unrounded equality with split legacy \`PRDA\` for ${prda_cases}
  channel/angle/wave cases.
- Exact DSG formula, threshold, and invalid-domain behavior in
  ${dsg_kernel_cases} direct pure-kernel cases.

The compatibility adapter preserves the known \`/PRSC/\` \`II\` mutation and
delegates only non-finite malformed-grid behavior to renamed legacy
\`PRDA_LEGACY\`/\`PROBS_LEGACY\`. The public APIs reject those invalid domains.
The background seam still invokes the frozen legacy formula routines behind
its explicit typed boundary; those routines no longer own configuration or
solution state.

- Dataset manifest SHA-256: \`${dataset_sha}\`
- Parity table SHA-256: \`${comparison_sha}\`
- Scalar kernel SHA-256: \`${kernel_sha}\`
- Solution/pure-kernel SHA-256: \`${solution_kernel_sha}\`
- Background seam SHA-256: \`${background_sha}\`
- PRDA/DSG adapter SHA-256: \`${adapter_sha}\`
- Nonzero-Born layer table SHA-256: \`${layer_sha}\`
- Pure PRDA/DSG table SHA-256: \`${pure_kernel_sha}\`

## Structural boundary

\`CM12Dataset\` and \`CM12Solution\` have private components and are populated
only by validating loaders. The native solution loader hashes source bytes
before parsing. The scalar multipole evaluator, pure amplitude accumulator,
and pure DSG operation perform no file I/O, use no COMMON block or mutable
cache, and receive all scientific inputs explicitly.

The compatibility process still owns legacy command parsing, grid
construction, kinematics orchestration, and transcript behavior so the
existing \`prsdd\` call site remains an oracle. New code must call the typed
loaders and operations directly.

## Pause gate

This requested extraction milestone is complete. Work is paused until the
user sends the exact command \`RESUME\`.
EOF

printf 'CM12 seam comparison passed: %s\n' "${markdown_report}"
