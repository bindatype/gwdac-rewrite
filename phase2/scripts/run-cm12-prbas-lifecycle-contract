#!/usr/bin/env bash
set -euo pipefail

readonly source_root="${ARNDT64_SOURCE:-/workspace/arndt64}"
readonly phase1_root="${PHASE1_ROOT:-/phase1}"
readonly phase2_root="${PHASE2_ROOT:-/phase2}"
readonly state_root="${PRBAS_LIFECYCLE_STATE_ROOT:-/workspace/phase2/prbas-lifecycle-contract}"
readonly report_root="${PRBAS_LIFECYCLE_REPORT_ROOT:-${phase2_root}/reports/cm12-prbas-lifecycle-contract/capture}"
readonly executable="${PRBAS_LIFECYCLE_BINARY:?set PRBAS_LIFECYCLE_BINARY to the diagnostic headless executable}"
readonly live_fixture="${phase1_root}/fixtures/go3pr2-production-adapter/live.in"
readonly lifecycle_fixture_root="${phase2_root}/fixtures/prbas-lifecycle"
readonly reload_fixture="${lifecycle_fixture_root}/reload.in"
readonly website_comparison="${phase1_root}/reports/go3pr2-adapter-diagnostic/comparison.tsv"
readonly typed_parser="${phase2_root}/scripts/parse-cm12-typed-lifecycle.awk"
readonly legacy_parser="${phase2_root}/scripts/parse-cm12-legacy-lifecycle.awk"
readonly lifecycle_comparator="${phase2_root}/scripts/compare-cm12-prbas-live-lifecycle.awk"
readonly kcm_root="${source_root}/said/KCM.100330"
readonly data_root="${source_root}/sdat"
readonly solution_file="${data_root}/prsol.dat"
readonly solution_sha256=dbcaae30bbf44aca6e5482fc2b10b81cb6e1033cf41061bc089d5f6a85576522
readonly timeout_seconds="${RUN_TIMEOUT_SECONDS:-240}"

mkdir -p "${report_root}" "${state_root}/runs"
test -x "${executable}"
test -f "${live_fixture}"
test -f "${reload_fixture}"
test -f "${website_comparison}"
(
    cd "${lifecycle_fixture_root}"
    sha256sum -c manifest.sha256
) >/dev/null

run_case() {
    local label="$1"
    local fixture="$2"
    local force_legacy="$3"
    local run_root
    local status
    local -a environment

    run_root="$(mktemp -d "${state_root}/runs/${label}.XXXXXX")"
    cp -a "${source_root}/pr" "${run_root}/pr"
    rm -f \
        "${run_root}/pr/SAID.TMP" \
        "${run_root}/pr/SAID.PCT" \
        "${run_root}/pr/SAID.LOG" \
        "${run_root}/pr/SAID.PS" \
        "${run_root}/pr/fort.3" \
        "${run_root}/pr/fort.7"
    ln -sfn "${kcm_root}" "${run_root}/pr/KCM"
    ln -s "${data_root}" "${run_root}/sdat"

    environment=(
        "CM12_KCM_ROOT=${kcm_root}"
        "CM12_SOLUTION_FILE=${solution_file}"
        "CM12_SOLUTION_SHA256=${solution_sha256}"
        "CM12_SOLUTION_ID=CM12"
        "SAID_DATA_ROOT=${data_root}"
        "TZ=America/New_York"
    )
    if [[ "${force_legacy}" == yes ]]; then
        environment+=("CM12_FORCE_LEGACY_PRBAS=1")
    fi

    set +e
    (
        cd "${run_root}/pr"
        timeout "${timeout_seconds}" env -u CM12_PRBAS_MODE \
            "${environment[@]}" "${executable}" <"${fixture}" \
            >"${report_root}/${label}.stdout" \
            2>"${report_root}/${label}.stderr"
    )
    status=$?
    set -e
    printf '%s\n' "${status}" >"${report_root}/${label}.exit"
    test "${status}" -eq 0
}

extract_scientific() {
    local input="$1"
    local selection="$2"
    local output="$3"

    awk -v selection="${selection}" '
        BEGIN { OFS = "\t" }
        index($0, "WEB") { section++ }
        NF == 5 && $1 ~ /^[+-]?[0-9]+\.[0-9]+$/ &&
            $2 ~ /^[+-]?0\.[0-9]+E[+-][0-9]+$/ &&
            $3 ~ /^[+-]?0\.[0-9]+E[+-][0-9]+$/ &&
            $4 ~ /^[+-]?[0-9]+\.[0-9]+([Ee][+-]?[0-9]+)?$/ &&
            $5 ~ /^[+-]?0\.[0-9]+E[+-][0-9]+$/ {
            if (selection == "go5" && section == 1) {
                if (!header++) print "row", "angle", "predicted_obs", \
                    "measured_obs", "error", "dchi"
                print ++row, $1, $2, $3, $4, $5
            }
            if ((selection == "go3" && section > 1) || \
                selection == "go3-all") {
                if (!header++) print "row", "section", "angle", \
                    "obs", "error", "lab_angle", "lab_dsg"
                print ++row, section, $1, $2, $3, $4, $5
            }
        }
    ' "${input}" >"${output}"
}

run_case typed-live "${live_fixture}" no
run_case legacy-live "${live_fixture}" yes
run_case legacy-reload "${reload_fixture}" yes

extract_scientific \
    "${report_root}/typed-live.stdout" go5 \
    "${report_root}/typed-live-go5.tsv"
extract_scientific \
    "${report_root}/legacy-live.stdout" go5 \
    "${report_root}/legacy-live-go5.tsv"
extract_scientific \
    "${report_root}/typed-live.stdout" go3 \
    "${report_root}/typed-live-go3.tsv"
extract_scientific \
    "${report_root}/legacy-live.stdout" go3 \
    "${report_root}/legacy-live-go3.tsv"
extract_scientific \
    "${report_root}/legacy-reload.stdout" go3-all \
    "${report_root}/legacy-reload-go3.tsv"

test "$(($(wc -l <"${report_root}/typed-live-go5.tsv") - 1))" -eq 1533
test "$(($(wc -l <"${report_root}/legacy-live-go5.tsv") - 1))" -eq 1533
test "$(($(wc -l <"${report_root}/typed-live-go3.tsv") - 1))" -eq 1
test "$(($(wc -l <"${report_root}/legacy-live-go3.tsv") - 1))" -eq 1
test "$(($(wc -l <"${report_root}/legacy-reload-go3.tsv") - 1))" -eq 2

awk -f "${typed_parser}" "${report_root}/typed-live.stdout" \
    >"${report_root}/typed-live-trace-all.tsv"
readonly live_call="$(awk -F '\t' 'NR > 1 { value=$1 } END { print value }' \
    "${report_root}/typed-live-trace-all.tsv")"
awk -F '\t' -v call_id="${live_call}" 'NR == 1 || $1 == call_id' \
    "${report_root}/typed-live-trace-all.tsv" \
    >"${report_root}/typed-live-trace.tsv"
test "$(($(wc -l <"${report_root}/typed-live-trace.tsv") - 1))" -eq 26

awk '
    BEGIN { OFS = "\t"; print "call_id", "energy_index", "ne", "na", \
        "ir", "ir0", "nnbt", "it", "nnl", "iprk", "nfg_nonzero", \
        "pg_nonzero", "bcoff", "kill", "solution", "selector", \
        "formula_title" }
    index($0, "CM12TYPED BEGIN ") {
        start = index($0, "CM12TYPED BEGIN ")
        count = split(substr($0, start), field)
        for (i = 3; i <= count; i++)
            printf "%s%s", field[i], (i == count ? ORS : OFS)
    }
' "${report_root}/typed-live.stdout" >"${report_root}/typed-live-ambient.tsv"

awk -f "${legacy_parser}" "${report_root}/legacy-live.stdout" \
    >"${report_root}/legacy-live-trace.tsv"
awk -f "${legacy_parser}" "${report_root}/legacy-reload.stdout" \
    >"${report_root}/legacy-reload-trace.tsv"
test "$(($(wc -l <"${report_root}/legacy-live-trace.tsv") - 1))" -eq 26
test "$(($(wc -l <"${report_root}/legacy-reload-trace.tsv") - 1))" -eq 52

awk -f "${lifecycle_comparator}" \
    "${report_root}/typed-live-trace.tsv" \
    "${report_root}/legacy-live-trace.tsv" \
    >"${report_root}/live-lifecycle-comparison.tsv"
test "$(($(wc -l <"${report_root}/live-lifecycle-comparison.tsv") - 1))" -eq 26

paste \
    "${report_root}/typed-live-go5.tsv" \
    "${report_root}/legacy-live-go5.tsv" |
    awk -F '\t' '
        BEGIN { OFS = "\t" }
        NR == 1 {
            print "row", "angle_equal", "predicted_equal", \
                "measured_equal", "error_equal", "dchi_equal", "exact", \
                "typed_predicted", "legacy_predicted", "typed_dchi", \
                "legacy_dchi"
            next
        }
        {
            angle = ($2 == $8 ? "yes" : "no")
            predicted = ($3 == $9 ? "yes" : "no")
            measured = ($4 == $10 ? "yes" : "no")
            error = ($5 == $11 ? "yes" : "no")
            dchi = ($6 == $12 ? "yes" : "no")
            exact = (angle == "yes" && predicted == "yes" && \
                measured == "yes" && error == "yes" && dchi == "yes" ? \
                "yes" : "no")
            print $1, angle, predicted, measured, error, dchi, exact, \
                $3, $9, $6, $12
        }
    ' >"${report_root}/live-go5-comparison.tsv"

readonly go5_exact_rows="$(awk -F '\t' 'NR > 1 && $7 == "yes" { count++ } \
    END { print count + 0 }' "${report_root}/live-go5-comparison.tsv")"
readonly go5_angle_rows="$(awk -F '\t' 'NR > 1 && $2 == "yes" { count++ } \
    END { print count + 0 }' "${report_root}/live-go5-comparison.tsv")"
readonly go5_predicted_rows="$(awk -F '\t' 'NR > 1 && $3 == "yes" { count++ } \
    END { print count + 0 }' "${report_root}/live-go5-comparison.tsv")"
readonly go5_measured_rows="$(awk -F '\t' 'NR > 1 && $4 == "yes" { count++ } \
    END { print count + 0 }' "${report_root}/live-go5-comparison.tsv")"
readonly go5_error_rows="$(awk -F '\t' 'NR > 1 && $5 == "yes" { count++ } \
    END { print count + 0 }' "${report_root}/live-go5-comparison.tsv")"
readonly go5_dchi_rows="$(awk -F '\t' 'NR > 1 && $6 == "yes" { count++ } \
    END { print count + 0 }' "${report_root}/live-go5-comparison.tsv")"
readonly lifecycle_exact_rows="$(awk -F '\t' 'NR > 1 && $25 == "yes" { count++ } \
    END { print count + 0 }' "${report_root}/live-lifecycle-comparison.tsv")"
readonly typed_go3="$(awk -F '\t' 'NR == 2 { print $4 }' \
    "${report_root}/typed-live-go3.tsv")"
readonly legacy_go3="$(awk -F '\t' 'NR == 2 { print $4 }' \
    "${report_root}/legacy-live-go3.tsv")"
readonly reload_first="$(awk -F '\t' 'NR == 2 { print $4 }' \
    "${report_root}/legacy-reload-go3.tsv")"
readonly reload_second="$(awk -F '\t' 'NR == 3 { print $4 }' \
    "${report_root}/legacy-reload-go3.tsv")"
readonly website_go3="$(awk -F '\t' 'NR > 1 { value[$5]=1 } \
    END { for (item in value) { if (++count > 1) exit 2; result=item } \
        print result }' "${website_comparison}")"

contract_status=FAIL
if [[ "${go5_exact_rows}" -eq 1533 && \
    "${typed_go3}" == "${legacy_go3}" && \
    "${typed_go3}" == "${website_go3}" ]]; then
    contract_status=PASS
fi
readonly contract_status

{
    printf 'metric\ttyped_or_exact\tlegacy_or_total\tresult\n'
    printf 'live_go5_complete_rows\t%s\t1533\t%s\n' \
        "${go5_exact_rows}" "$([[ "${go5_exact_rows}" -eq 1533 ]] && echo PASS || echo FAIL)"
    printf 'live_go5_angle_rows\t%s\t1533\t%s\n' \
        "${go5_angle_rows}" "$([[ "${go5_angle_rows}" -eq 1533 ]] && echo PASS || echo FAIL)"
    printf 'live_go5_predicted_rows\t%s\t1533\t%s\n' \
        "${go5_predicted_rows}" "$([[ "${go5_predicted_rows}" -eq 1533 ]] && echo PASS || echo FAIL)"
    printf 'live_go5_measured_rows\t%s\t1533\t%s\n' \
        "${go5_measured_rows}" "$([[ "${go5_measured_rows}" -eq 1533 ]] && echo PASS || echo FAIL)"
    printf 'live_go5_error_rows\t%s\t1533\t%s\n' \
        "${go5_error_rows}" "$([[ "${go5_error_rows}" -eq 1533 ]] && echo PASS || echo FAIL)"
    printf 'live_go5_dchi_rows\t%s\t1533\t%s\n' \
        "${go5_dchi_rows}" "$([[ "${go5_dchi_rows}" -eq 1533 ]] && echo PASS || echo FAIL)"
    printf 'live_lifecycle_exact_rows\t%s\t26\t%s\n' \
        "${lifecycle_exact_rows}" "$([[ "${lifecycle_exact_rows}" -eq 26 ]] && echo PASS || echo FAIL)"
    printf 'live_go3_observable\t%s\t%s\t%s\n' \
        "${typed_go3}" "${legacy_go3}" "$([[ "${typed_go3}" == "${legacy_go3}" ]] && echo PASS || echo FAIL)"
    printf 'captured_website_observable\t%s\t%s\t%s\n' \
        "${typed_go3}" "${website_go3}" "$([[ "${typed_go3}" == "${website_go3}" ]] && echo PASS || echo FAIL)"
    printf 'legacy_reload_observables\t%s\t%s\tCAPTURED\n' \
        "${reload_first}" "${reload_second}"
    printf 'contract\t%s\tPASS\t%s\n' "${contract_status}" "${contract_status}"
} >"${report_root}/summary.tsv"

{
    printf 'evidence_label=captured/reference-candidate\n'
    printf 'archived_source_commit=%s\n' "$(git -C "${source_root}" rev-parse HEAD)"
    printf 'diagnostic_executable_sha256=%s\n' "$(sha256sum "${executable}" | awk '{print $1}')"
    printf 'live_fixture_sha256=%s\n' "$(sha256sum "${live_fixture}" | awk '{print $1}')"
    printf 'reload_fixture_sha256=%s\n' "$(sha256sum "${reload_fixture}" | awk '{print $1}')"
    printf 'solution_sha256=%s\n' "$(sha256sum "${solution_file}" | awk '{print $1}')"
    printf 'typed_live_call=%s\n' "${live_call}"
    printf 'timezone=America/New_York\n'
    printf 'contract_status=%s\n' "${contract_status}"
    . /etc/os-release
    printf 'container_os=%s\n' "${PRETTY_NAME}"
} >"${report_root}/run-context.txt"

for label in typed-live legacy-live legacy-reload; do
    gzip -n -f "${report_root}/${label}.stdout"
done

(
    cd "${report_root}"
    find . -maxdepth 1 -type f ! -name manifest.sha256 -print0 |
        sort -z |
        xargs -0 sha256sum >manifest.sha256
)

printf 'PRBAS lifecycle contract: %s\n' "${contract_status}"
printf 'Evidence: %s\n' "${report_root}"
[[ "${contract_status}" == PASS ]]
