#!/usr/bin/env bash
set -euo pipefail

readonly source_root="${ARNDT64_SOURCE:-/workspace/arndt64}"
readonly phase1_report_root="${PHASE1_REPORT_ROOT:-/phase1/reports}"
readonly phase2_root="${PHASE2_ROOT:-/phase2}"
readonly report_root="${PHASE2_REPORT_ROOT:-${phase2_root}/reports}"
readonly source_commit="$(
    awk -F= '$1 == "source_commit" { print $2 }' \
        "${phase1_report_root}/build-manifest.txt"
)"
readonly short_commit="${source_commit:0:12}"
readonly artifact_root="/workspace/phase2/reproducible/artifacts/${short_commit}"
readonly diagnostic_binary="${artifact_root}/prsdd-headless"
readonly accepted_launcher="${artifact_root}/prsdd-headless-cm12-accepted"
readonly fixture="${phase2_root}/fixtures/decks/cm12_pi_plus_dsg_baseline.in"
readonly kcm_root="${source_root}/said/KCM.100330"
readonly data_root="${source_root}/sdat"
readonly solution_file="${data_root}/prsol.dat"
readonly solution_sha256="dbcaae30bbf44aca6e5482fc2b10b81cb6e1033cf41061bc089d5f6a85576522"
readonly route_root="${report_root}/accepted-route"
readonly state_root="/workspace/phase2/accepted-route"
readonly route_table="${route_root}/route.tsv"

mkdir -p "${route_root}" "${state_root}/runs"
test -x "${diagnostic_binary}"
test -x "${accepted_launcher}"
test -f "${fixture}"

run_route() {
    local label="$1"
    local executable="$2"
    local run_root
    local stdout_file="${route_root}/${label}.stdout"
    local stderr_file="${route_root}/${label}.stderr"
    local status_file="${route_root}/${label}.exit"
    local status

    run_root="$(mktemp -d "${state_root}/runs/${label}.XXXXXX")"
    cp -a "${source_root}/pr" "${run_root}/pr"
    rm -f \
        "${run_root}/pr/SAID.TMP" \
        "${run_root}/pr/SAID.PCT" \
        "${run_root}/pr/SAID.LOG" \
        "${run_root}/pr/SAID.PS" \
        "${run_root}/pr/fort.3" \
        "${run_root}/pr/fort.7"
    ln -sfn "${kcm_root}" "${run_root}/pr/KCM"
    ln -s "${data_root}" "${run_root}/sdat"

    set +e
    (
        cd "${run_root}/pr"
        env \
            CM12_FORCE_LEGACY_PRBAS=1 \
            CM12_KCM_ROOT="${kcm_root}" \
            CM12_SOLUTION_FILE="${solution_file}" \
            CM12_SOLUTION_SHA256="${solution_sha256}" \
            CM12_SOLUTION_ID=CM12 \
            SAID_DATA_ROOT="${data_root}" \
            LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}" \
            "${executable}" \
            <"${fixture}" \
            >"${stdout_file}" \
            2>"${stderr_file}"
    )
    status=$?
    set -e
    printf '%s\n' "${status}" >"${status_file}"
}

run_route diagnostic "${diagnostic_binary}"
run_route accepted "${accepted_launcher}"

diagnostic_status="$(<"${route_root}/diagnostic.exit")"
accepted_status="$(<"${route_root}/accepted.exit")"
diagnostic_rows="$(
    awk '/CM12DIAG/ { count++ } END { print count + 0 }' \
        "${route_root}/diagnostic.stdout"
)"
accepted_rows="$(
    awk '/CM12DIAG/ { count++ } END { print count + 0 }' \
        "${route_root}/accepted.stdout"
)"

[[ "${diagnostic_status}" -eq 0 ]]
[[ "${accepted_status}" -eq 0 ]]
[[ "${diagnostic_rows}" -gt 0 ]]
[[ "${accepted_rows}" -eq 0 ]]
grep -Fq 'Thanks for using SAID' "${route_root}/diagnostic.stdout"
grep -Fq 'Thanks for using SAID' "${route_root}/accepted.stdout"

{
    printf '%s\n' $'route\texit_status\tcm12diag_rows\tstdout_sha256\tstderr_sha256'
    printf 'diagnostic\t%s\t%s\t%s\t%s\n' \
        "${diagnostic_status}" \
        "${diagnostic_rows}" \
        "$(sha256sum "${route_root}/diagnostic.stdout" | awk '{print $1}')" \
        "$(sha256sum "${route_root}/diagnostic.stderr" | awk '{print $1}')"
    printf 'accepted\t%s\t%s\t%s\t%s\n' \
        "${accepted_status}" \
        "${accepted_rows}" \
        "$(sha256sum "${route_root}/accepted.stdout" | awk '{print $1}')" \
        "$(sha256sum "${route_root}/accepted.stderr" | awk '{print $1}')"
} >"${route_table}"

printf 'Accepted route assertion passed: %s\n' "${route_table}"
