"${artifact_root}/cm12-prbas-dispatch-probe" \
    "${solution_file}" "${solution_sha256}" \
    "${report_root}/hadronic-pipeline-diagnostic/legacy-pipeline-trace.tsv" \
    >"${prbas_report_root}/hadronic-dispatch.tsv"
awk -F '\t' '
    NR > 1 && $11 != "T" { exit 1 }
    END { if (NR != 19) exit 1 }
' "${prbas_report_root}/hadronic-dispatch.tsv"

"${artifact_root}/cm12-prbas-contract-probe" \
    "${solution_file}" "${solution_sha256}" \
    >"${prbas_report_root}/negative-contracts.tsv"
awk -F '\t' '
    NR == 1 && $1 == "contract" && $2 == "status" && $3 == "message" { next }
    NR == 2 && $1 == "non_printable_title" && $2 == 1 && \
        $3 == "frozen hadronic formula returned a non-printable title" { next }
    NR == 3 && $1 == "ambient_supported" && $2 == 0 && $3 == "<empty>" { next }
    NR == 4 && $1 == "ambient_it_rejected" && $2 == 1 && \
        $3 == "typed PRBAS requires retained IT=1" { next }
    NR == 5 && $1 == "ambient_nnl_rejected" && $2 == 1 && \
        $3 == "typed PRBAS requires retained NNL=6" { next }
    NR == 6 && $1 == "ambient_iprk_rejected" && $2 == 1 && \
        $3 == "typed PRBAS does not support IPRK scaling" { next }
    NR == 7 && $1 == "ambient_bcoff_rejected" && $2 == 1 && \
        $3 == "typed PRBAS requires retained BCOFF=0" { next }
    NR == 8 && $1 == "ambient_kill_rejected" && $2 == 1 && \
        $3 == "typed PRBAS requires retained KILL=0" { next }
    NR == 9 && $1 == "ambient_nfg_rejected" && $2 == 1 && \
        $3 == "typed PRBAS does not support PNMOD overrides" { next }
    NR == 10 && $1 == "ambient_pg_rejected" && $2 == 1 && \
        $3 == "typed PRBAS does not support PGLOB parameters" { next }
    NR == 11 && $1 == "process_state_survives_request" && $2 == 0 && \
        $3 == "<empty>" { next }
    NR == 12 && $1 == "solution_reload_preserves_process" && $2 == 0 && \
        $3 == "<empty>" { next }
    NR == 13 && $1 == "initialize_grid" && $2 == 0 && $3 == "<empty>" { next }
    NR == 14 && $1 == "reaction_mismatch" && $2 == 1 && \
        $3 == "background grid state provenance does not match request" { next }
    NR == 15 && $1 == "original_reaction_reuse" && $2 == 0 && \
        $3 == "<empty>" { next }
    { exit 1 }
    END { if (NR != 15) exit 1 }
' "${prbas_report_root}/negative-contracts.tsv"
awk -F '\t' 'NR == 1 || $1 ~ /^ambient_/' \
    "${prbas_report_root}/negative-contracts.tsv" \
    >"${probe_build_root}/pre-dispatch-eligibility.tsv"
cmp "${pre_dispatch_fixture}" \
    "${probe_build_root}/pre-dispatch-eligibility.tsv"

"${artifact_root}/cm12-form-diagnostic-probe" \
    "${solution_file}" "${solution_sha256}" "${kcm_root}" \
    "${report_root}/cm12-form-diagnostic/legacy-form-trace.tsv" \
    "${report_root}/cm12-form-diagnostic/legacy-target-summary.tsv" \
    '0.2036E+01' >"${prbas_report_root}/form-contributions.tsv"
grep -Fq 'exact_candidate_deltas=40' \
    "${prbas_report_root}/form-contributions.tsv"
grep -Fq 'candidate_amplitudes_exact=T' \
    "${prbas_report_root}/form-contributions.tsv"
grep -Fq 'candidate_dsg_exact=T' \
    "${prbas_report_root}/form-contributions.tsv"
grep -Fq 'request_result_exact=T' \
    "${prbas_report_root}/form-contributions.tsv"

if nm "${artifact_root}/prsdd-headless" |
    grep -Eq '[[:space:]](ys_|gettm_|mjl2cpw_|kos_)$'; then
    printf 'Legacy ysKCM symbol remains in the CM12 seam binary\n' >&2
    exit 1
fi

{
    printf 'source_commit=%s\n' "${commit}"
    printf 'build_variant=cm12-pure-kernel-seam\n'
    printf 'kcm_root=%s\n' "${kcm_root}"
    printf 'solution_file=%s\n' "${solution_file}"
    printf 'solution_sha256=%s\n' "${solution_sha256}"
    sha256sum \
        "${artifact_root}/prsdd-headless" \
        "${artifact_root}/prsdd-headless-cm12-accepted" \
        "${artifact_root}/cm12-dataset-probe" \
        "${artifact_root}/cm12-solution-probe" \
        "${artifact_root}/cm12-scalar-parity-probe" \
        "${artifact_root}/cm12-layer-parity-probe" \
        "${artifact_root}/cm12-pure-kernel-probe" \
        "${artifact_root}/cm12-request-probe" \
        "${artifact_root}/cm12-form-diagnostic-probe" \
        "${artifact_root}/cm12-prbas-dispatch-probe" \
        "${artifact_root}/cm12-prbas-contract-probe" \
        "${kernel_root}/cm12_kernel.f90" \
        "${kernel_root}/cm12_solution.f90" \
        "${kernel_root}/cm12_background_seam.f90" \
        "${kernel_root}/cm12_prbas_dispatch.f90" \
        "${kernel_root}/cm12_non_cm12_seam.f90" \
        "${kernel_root}/cm12_request_kernel.f90" \
        "${kernel_root}/cm12_legacy_context.f90" \
        "${kernel_root}/cmmwp_seam.f90" \
        "${kernel_root}/cm12_prda_probs_seam.f90" \
        "${kernel_root}/cm12_prbas_seam.f90" \
        "${kernel_root}/cm12_request_probe.f90" \
        "${kernel_root}/cm12_pure_kernel_probe.f90" \
        "${kernel_root}/cm12_form_diagnostic_probe.f90" \
        "${kernel_root}/cm12_prbas_dispatch_probe.f90" \
        "${kernel_root}/cm12_prbas_contract_probe.f90" \
        "${kernel_root}/cm12_prsd_pure.patch" \
        "${pre_dispatch_fixture}" \
        "${report_root}/cm12-dataset-loader.tsv" \
        "${report_root}/cm12-dataset-rejection.txt" \
        "${report_root}/cm12-solution-loader.tsv" \
        "${report_root}/cm12-solution-hash-rejection.txt" \
        "${report_root}/cm12-solution-id-rejection.txt" \
        "${report_root}/cm12-scalar-parity.tsv" \
        "${report_root}/cm12-layer-parity.tsv" \
        "${report_root}/cm12-pure-kernel-parity.tsv" \
        "${prbas_report_root}/hadronic-dispatch.tsv" \
        "${prbas_report_root}/negative-contracts.tsv" \
        "${prbas_report_root}/form-contributions.tsv"
    if [[ "${request_probe_status}" -eq 0 ]]; then
        sha256sum "${report_root}/cm12-request-orchestration.tsv"
    fi
    printf 'removed_legacy_symbols=ys_,gettm_,mjl2cpw_,kos_\n'
    printf 'pure_valid_domain_symbols=prda_,probs_\n'
    printf 'legacy_nonfinite_fallback_symbols=prda_legacy_,probs_legacy_\n'
    printf 'pure_request_symbol=__cm12_request_kernel_MOD_cm12_evaluate_request\n'
    printf 'legacy_prbas_fallback_symbol=prbas_legacy_\n'
    printf 'request_probe_exit=%s\n' "${request_probe_status}"
    printf 'request_probe_mismatch_allowed=%s\n' \
        "${allow_request_probe_mismatch}"
    printf 'request_probe_skipped=%s\n' "${skip_request_probe}"
} >"${report_root}/cm12-seam-build-manifest.txt"

printf 'Built CM12 seam: %s\n' "${artifact_root}/prsdd-headless"
printf 'Validated dataset loader: %s\n' \
