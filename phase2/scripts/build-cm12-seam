    "${report_root}/cm12-solution-loader.tsv"
printf 'Validated pure layers: %s\n' \
    "${report_root}/cm12-layer-parity.tsv"
printf 'Validated pure PRDA/DSG kernels: %s\n' \
    "${report_root}/cm12-pure-kernel-parity.tsv"
if [[ "${request_probe_status}" -eq 0 ]]; then
    printf 'Validated pure request orchestration: %s\n' \
        "${report_root}/cm12-request-orchestration.tsv"
else
    printf 'Pure request orchestration probe skipped for focused validation\n'
fi
printf 'Validated focused PRBAS dispatch: %s\n' \
    "${prbas_report_root}/hadronic-dispatch.tsv"
printf 'Validated PRBAS negative contracts: %s\n' \
    "${prbas_report_root}/negative-contracts.tsv"
printf 'Validated focused PRBAS contributions: %s\n' \
    "${prbas_report_root}/form-contributions.tsv"
