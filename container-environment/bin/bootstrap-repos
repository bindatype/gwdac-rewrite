#!/usr/bin/env bash
set -euo pipefail

readonly workspace="${GWDAC_WORKSPACE:-/workspace}"

clone_and_verify() {
    local name="$1"
    local expected_commit="$2"
    local target="${workspace}/${name}"

    if [[ ! -d "${target}/.git" ]]; then
        git clone "/archives/${name}.bundle" "${target}"
    fi

    local actual_commit
    actual_commit="$(git -C "${target}" rev-parse HEAD)"
    if [[ "${actual_commit}" != "${expected_commit}" ]]; then
        printf 'Unexpected %s HEAD: expected %s, found %s\n' \
            "${name}" "${expected_commit}" "${actual_commit}" >&2
        return 1
    fi
}

mkdir -p "${workspace}"
clone_and_verify gwdac aacdf975295d11eb0ec7529edd8fd549025dcd4d
clone_and_verify arndt64 f6c81d01a1fe8b007c247acc2213f821a62dc4f2

printf 'Restored both repositories under %s\n' "${workspace}"
