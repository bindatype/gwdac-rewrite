#!/usr/bin/env bash
set -euo pipefail

readonly script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly outputs_root="$(cd "${script_root}/.." && pwd)"
readonly verifier="${outputs_root}/phase1/scripts/verify-checkpoint3a-measurement"
readonly volatile_ledger_verifier="${outputs_root}/phase1/scripts/verify-checkpoint3a-volatile-ledger"
readonly registry="${outputs_root}/phase1/config/checkpoint3a-engines.tsv"
readonly workspace="$(mktemp -d "${TMPDIR:-/tmp}/checkpoint3a-contract.XXXXXX")"

cleanup() {
    rm -rf "${workspace}"
}
trap cleanup EXIT

for tool in awk head mktemp; do
    if ! command -v "${tool}" >/dev/null 2>&1; then
        printf 'checkpoint 3A contract fixtures: missing tool: %s\n' \
            "${tool}" >&2
        exit 40
    fi
done

set +e
"${verifier}" unregistered-engine >"${workspace}/unsupported.stdout" \
    2>"${workspace}/unsupported.stderr"
unsupported_status=$?
set -e
if [[ "${unsupported_status}" -ne 64 ]]; then
    printf 'checkpoint 3A contract fixtures: unsupported engine status=%s expected=64\n' \
        "${unsupported_status}" >&2
    exit 1
fi

{
    head -n 1 "${registry}"
    awk -F '\t' 'NR == 2 {print $1 "\t" $2 "\t" $3}' "${registry}"
} >"${workspace}/incomplete.tsv"
set +e
CHECKPOINT3A_REGISTRY="${workspace}/incomplete.tsv" \
    "${verifier}" pdsd >"${workspace}/incomplete.stdout" \
        2>"${workspace}/incomplete.stderr"
incomplete_status=$?
set -e
if [[ "${incomplete_status}" -ne 64 ]]; then
    printf 'checkpoint 3A contract fixtures: incomplete row status=%s expected=64\n' \
        "${incomplete_status}" >&2
    exit 1
fi

"${volatile_ledger_verifier}" \
    "${outputs_root}/phase1/reports/checkpoint3a1-pdsd-measurement/volatile-fields.tsv" \
    1 1
"${volatile_ledger_verifier}" \
    "${outputs_root}/phase1/reports/checkpoint3a2-knsd-measurement/volatile-fields.tsv" \
    7 9

awk -F '\t' 'BEGIN {OFS = "\t"} NR == 7 {$4++} {print}' \
    "${outputs_root}/phase1/reports/checkpoint3a2-knsd-measurement/volatile-fields.tsv" \
    >"${workspace}/corrupt-observed-count.tsv"
set +e
"${volatile_ledger_verifier}" "${workspace}/corrupt-observed-count.tsv" 7 9 \
    >"${workspace}/corrupt.stdout" 2>"${workspace}/corrupt.stderr"
corrupt_status=$?
set -e
if [[ "${corrupt_status}" -ne 1 ]]; then
    printf 'checkpoint 3A contract fixtures: corrupt observed count status=%s expected=1\n' \
        "${corrupt_status}" >&2
    exit 1
fi

printf 'checkpoint 3A contract fixtures: PASS unsupported=1 incomplete=1 volatile_positive=2 volatile_tally_negative=1\n'
