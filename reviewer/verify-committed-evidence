#!/usr/bin/env bash
set -uo pipefail

readonly script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly outputs_root="$(cd "${script_root}/.." && pwd)"
source "${script_root}/lib/exit-codes.sh"

usage() {
	printf 'usage: %s --expected-commit COMMIT\n' "$0"
	printf 'Verify committed evidence without invoking generators or Docker.\n'
}

expected_commit=''
if [[ "$#" -eq 2 && "$1" == --expected-commit ]]; then
	expected_commit="$2"
elif [[ "$#" -ne 0 ]]; then
	usage >&2
	exit 64
fi

for tool in git awk cmp wc mktemp; do
    if ! command -v "${tool}" >/dev/null 2>&1; then
        printf 'INFRASTRUCTURE FAIL missing tool: %s\n' "${tool}" >&2
        exit "${REVIEWER_EXIT_INFRASTRUCTURE}"
    fi
done

if command -v sha256sum >/dev/null 2>&1; then
    hash_file() { sha256sum "$1" | awk '{print $1}'; }
elif command -v shasum >/dev/null 2>&1; then
    hash_file() { shasum -a 256 "$1" | awk '{print $1}'; }
else
    printf 'INFRASTRUCTURE FAIL missing SHA-256 tool\n' >&2
    exit "${REVIEWER_EXIT_INFRASTRUCTURE}"
fi

if ! git -C "${outputs_root}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	printf 'INFRASTRUCTURE FAIL not a Git worktree: %s\n' "${outputs_root}" >&2
	exit "${REVIEWER_EXIT_INFRASTRUCTURE}"
fi

readonly commit="$(git -C "${outputs_root}" rev-parse --verify 'HEAD^{commit}')"
printf 'VERIFY commit=%s expected=%s\n' \
	"${commit}" "${expected_commit:-missing}"

identity_failure=''
if [[ -z "${expected_commit}" ]]; then
	identity_failure='gate identity missing expected commit'
elif [[ "${#expected_commit}" -ne 40 || \
	"${expected_commit}" == *[!0123456789abcdef]* ]]; then
	identity_failure="gate identity expected commit is not lowercase 40-hex: ${expected_commit}"
elif [[ "${expected_commit}" != "${commit}" ]]; then
	identity_failure="gate identity mismatch expected=${expected_commit} actual=${commit}"
fi
if [[ -n "${identity_failure}" ]]; then
	printf 'INTEGRITY FAIL %s\n' "${identity_failure}" >&2
	printf 'RESULT evidence_integrity_fail failures=1 exit=%s commit=%s\n' \
		"${REVIEWER_EXIT_EVIDENCE_INTEGRITY}" "${commit}"
	exit "${REVIEWER_EXIT_EVIDENCE_INTEGRITY}"
fi

readonly before_status="$(mktemp)"
readonly after_status="$(mktemp)"
cleanup() {
    rm -f "${before_status}" "${after_status}"
}
trap cleanup EXIT

git -C "${outputs_root}" status --porcelain=v1 --untracked-files=all \
    >"${before_status}"

integrity_failures=0
pass_count=0

integrity_failure() {
    printf 'INTEGRITY FAIL %s\n' "$*" >&2
    integrity_failures=$((integrity_failures + 1))
}

check_tracked_file() {
    local relative="$1"
    local absolute="${outputs_root}/${relative}"

    if ! git -C "${outputs_root}" ls-files --error-unmatch -- "${relative}" \
        >/dev/null 2>&1; then
        integrity_failure "untracked or absent from HEAD: ${relative}"
        return 1
    fi
    if [[ ! -f "${absolute}" ]]; then
        integrity_failure "missing file: ${relative}"
        return 1
    fi
    if ! git -C "${outputs_root}" diff --quiet HEAD -- "${relative}"; then
        integrity_failure "working copy differs from HEAD: ${relative}"
        return 1
    fi
	return 0
}

for gate_contract_file in \
	reviewer/verify-committed-evidence \
	reviewer/verify-evidence-sort-policy \
		reviewer/verify-evidence-sort-policy-fixtures \
		reviewer/verify-cm12-harness-contract \
		reviewer/verify-cm12-harness-contract-fixtures \
		reviewer/verify-runtime-refresh-contract-fixtures \
		reviewer/verify-checkpoint3a-contract \
		reviewer/verify-checkpoint3a-contract-fixtures \
		reviewer/verify-checkpoint3a-relation-fixtures \
		reviewer/write-runtime-refresh-aggregate \
		reviewer/lib/exit-codes.sh \
		reviewer/config/evidence-manifests.tsv \
		reviewer/config/runtime-refresh-packages.tsv \
		phase1/config/checkpoint3a-engines.tsv \
		phase1/scripts/classify-checkpoint3a-relation \
		phase1/scripts/run-checkpoint3a-measurement \
		phase1/scripts/verify-checkpoint3a-measurement \
		reviewer/fixtures/checkpoint3a-relations/data-root.left.txt \
		reviewer/fixtures/checkpoint3a-relations/data-root.negative.txt \
		reviewer/fixtures/checkpoint3a-relations/data-root.right.txt \
		reviewer/fixtures/checkpoint3a-relations/date.left.txt \
		reviewer/fixtures/checkpoint3a-relations/date.negative.txt \
		reviewer/fixtures/checkpoint3a-relations/date.right.txt \
		reviewer/fixtures/checkpoint3a-relations/exact.left.txt \
		reviewer/fixtures/checkpoint3a-relations/exact.right.txt; do
	check_tracked_file "${gate_contract_file}" || true
done

manifest_target() {
    local base="$1"
    local target="$2"

    case "${target}" in
        /phase1/*)
            printf 'phase1/%s' "${target#/phase1/}"
            ;;
        /*)
            return 1
            ;;
        *)
            if [[ "${base}" == . ]]; then
                printf '%s' "${target#./}"
            else
                printf '%s/%s' "${base%/}" "${target#./}"
            fi
            ;;
    esac
}

verify_manifest() {
    local label="$1"
    local base="$2"
    local manifest="$3"
    local expected
    local target
    local relative
    local actual
    local package_failed=0
    local checked=0

    if ! check_tracked_file "${manifest}"; then
        printf 'PACKAGE FAIL %-28s manifest unavailable\n' "${label}"
        return
    fi

    while read -r expected target; do
        if [[ -z "${expected:-}" || -z "${target:-}" ]]; then
            continue
        fi
        if ! relative="$(manifest_target "${base}" "${target}")"; then
            integrity_failure "${label}: unsupported absolute path ${target}"
            package_failed=1
            continue
        fi
        if ! check_tracked_file "${relative}"; then
            package_failed=1
            continue
        fi
        actual="$(hash_file "${outputs_root}/${relative}")"
        if [[ "${actual}" != "${expected}" ]]; then
            integrity_failure "${label}: SHA-256 mismatch ${relative}"
            package_failed=1
        fi
        checked=$((checked + 1))
    done <"${outputs_root}/${manifest}"

    if [[ "${package_failed}" -eq 0 ]]; then
        printf 'PACKAGE PASS %-28s files=%s\n' "${label}" "${checked}"
        pass_count=$((pass_count + 1))
    else
        printf 'PACKAGE FAIL %-28s files_checked=%s\n' "${label}" "${checked}"
    fi
}

verify_runtime_refresh_package() {
	local label="$1"
	local engine="$2"
	local base="$3"
	local manifest="$4"
	local checkpoint="$5"
	local summary='phase1/reports/runtime-refresh/summary.tsv'
	local target
	local relative
	local changed_path=''
	local summary_count
	local summary_checkpoint
	local contract_failed=0

	if [[ "${#checkpoint}" -ne 40 || \
		"${checkpoint}" == *[!0123456789abcdef]* ]]; then
		integrity_failure "${label}: checkpoint is not lowercase 40-hex: ${checkpoint}"
		contract_failed=1
	elif ! git -C "${outputs_root}" cat-file -e "${checkpoint}^{commit}" 2>/dev/null; then
		integrity_failure "${label}: checkpoint commit unavailable: ${checkpoint}"
		contract_failed=1
	elif ! git -C "${outputs_root}" merge-base --is-ancestor \
		"${checkpoint}" HEAD; then
		integrity_failure "${label}: checkpoint is not an ancestor of HEAD: ${checkpoint}"
		contract_failed=1
	fi

	if [[ "${contract_failed}" -eq 0 ]] && check_tracked_file "${manifest}"; then
		if ! git -C "${outputs_root}" diff --quiet \
			"${checkpoint}" HEAD -- "${manifest}"; then
			changed_path="${manifest}"
		fi
		while [[ -z "${changed_path}" ]] && read -r _ target; do
			if [[ -z "${target:-}" ]]; then
				continue
			fi
			if ! relative="$(manifest_target "${base}" "${target}")"; then
				changed_path="unsupported:${target}"
				break
			fi
			if ! git -C "${outputs_root}" diff --quiet \
				"${checkpoint}" HEAD -- "${relative}"; then
				changed_path="${relative}"
			fi
		done <"${outputs_root}/${manifest}"
		if [[ -n "${changed_path}" ]]; then
			integrity_failure \
				"${label}: checkpoint ${checkpoint} does not reproduce HEAD path=${changed_path}"
			contract_failed=1
		fi
	else
		contract_failed=1
	fi

	if ! check_tracked_file "${summary}"; then
		contract_failed=1
	else
		summary_count="$(awk -F '\t' -v engine="${engine}" \
			'$1 == engine {count++} END {print count + 0}' \
			"${outputs_root}/${summary}")"
		summary_checkpoint="$(awk -F '\t' -v engine="${engine}" \
			'$1 == engine {print $9; exit}' "${outputs_root}/${summary}")"
		if [[ "${summary_count}" -ne 1 ]]; then
			integrity_failure \
				"${label}: summary rows=${summary_count} expected=1"
			contract_failed=1
		elif [[ "${summary_checkpoint}" != "${checkpoint:0:7}" ]]; then
			integrity_failure \
				"${label}: summary checkpoint=${summary_checkpoint} expected=${checkpoint:0:7}"
			contract_failed=1
		fi
	fi

	if [[ "${contract_failed}" -eq 0 ]]; then
		printf 'CONTRACT PASS %-28s checkpoint=%s\n' \
			"${label}" "${checkpoint:0:7}"
	else
		printf 'CONTRACT FAIL %-28s checkpoint=%s\n' \
			"${label}" "${checkpoint:0:7}"
	fi
}

verify_runtime_refresh_aggregate_contract() {
	local registry="$1"
	local aggregate='phase1/reports/runtime-refresh/aggregate-manifest.sha256'
	local row=0
	local expected_rows
	local actual_path
	local expected_path
	local contract_failed=0

	if ! check_tracked_file "${aggregate}"; then
		printf 'CONTRACT FAIL runtime-refresh-aggregate-derived unavailable\n'
		return
	fi

	expected_rows="$((3 + $(awk -F '\t' 'NR > 1 {count++} END {print count + 0}' \
		"${outputs_root}/${registry}")))"
	while read -r _ actual_path; do
		row=$((row + 1))
		case "${row}" in
			1) expected_path='phase1/reports/runtime-refresh/README.md' ;;
			2) expected_path='phase1/reports/runtime-refresh/summary.tsv' ;;
			3) expected_path='reviewer/config/runtime-refresh-packages.tsv' ;;
			*)
				expected_path="$(awk -F '\t' -v wanted="$((row - 3))" \
					'NR > 1 {count++} count == wanted {print $4; exit}' \
					"${outputs_root}/${registry}")"
				;;
		esac
		if [[ "${actual_path}" != "${expected_path}" ]]; then
			integrity_failure \
				"runtime-refresh-aggregate-derived: row=${row} path=${actual_path} expected=${expected_path}"
			contract_failed=1
		fi
	done <"${outputs_root}/${aggregate}"

	if [[ "${row}" -ne "${expected_rows}" ]]; then
		integrity_failure \
			"runtime-refresh-aggregate-derived: rows=${row} expected=${expected_rows}"
		contract_failed=1
	fi
	if [[ "${contract_failed}" -eq 0 ]]; then
		printf 'CONTRACT PASS runtime-refresh-aggregate-derived files=%s\n' \
			"${row}"
	else
		printf 'CONTRACT FAIL runtime-refresh-aggregate-derived files=%s\n' \
			"${row}"
	fi
}

verify_unpatched_priming_summary() {
    local summary='phase1/reports/unpatched-priming-evidence-determinism-20260820/summary.tsv'
    local artifacts='phase1/reports/unpatched-priming-evidence-determinism-20260820/artifact-hashes.tsv'
    local summary_count
    local summary_value
    local artifact_count
    local context
    local artifact
    local row_count
    local row_value
    local contract_failed=0

    if ! check_tracked_file "${summary}"; then
        contract_failed=1
    fi
    if ! check_tracked_file "${artifacts}"; then
        contract_failed=1
    fi
    if [[ "${contract_failed}" -ne 0 ]]; then
        printf 'CONTRACT FAIL unpatched-priming-summary files unavailable\n'
        return
    fi

    summary_count="$(awk -F '\t' \
        '$1 == "canonical_manifest_sha256" { count++ } END { print count + 0 }' \
        "${outputs_root}/${summary}")"
    summary_value="$(awk -F '\t' \
        '$1 == "canonical_manifest_sha256" { print $2; exit }' \
        "${outputs_root}/${summary}")"
    if [[ "${summary_count}" -ne 1 ]]; then
        integrity_failure \
            "unpatched-priming-summary: canonical_manifest_sha256 rows=${summary_count} expected=1"
        contract_failed=1
    fi
    if [[ "${#summary_value}" -ne 64 || \
        "${summary_value}" == *[!0123456789abcdef]* ]]; then
        integrity_failure \
            'unpatched-priming-summary: canonical_manifest_sha256 is not lowercase 64-hex'
        contract_failed=1
    fi

    artifact_count="$(awk -F '\t' \
        '$2 == "canonical-manifest.sha256" || \
         $2 == "committed-canonical-manifest.sha256" { count++ } \
         END { print count + 0 }' \
        "${outputs_root}/${artifacts}")"
    if [[ "${artifact_count}" -ne 4 ]]; then
        integrity_failure \
            "unpatched-priming-summary: canonical artifact rows=${artifact_count} expected=4"
        contract_failed=1
    fi

    for context in kiritimati gmt-minus-12; do
        for artifact in canonical-manifest.sha256 committed-canonical-manifest.sha256; do
            row_count="$(awk -F '\t' -v context="${context}" -v artifact="${artifact}" \
                '$1 == context && $2 == artifact { count++ } END { print count + 0 }' \
                "${outputs_root}/${artifacts}")"
            row_value="$(awk -F '\t' -v context="${context}" -v artifact="${artifact}" \
                '$1 == context && $2 == artifact { print $3; exit }' \
                "${outputs_root}/${artifacts}")"
            if [[ "${row_count}" -ne 1 ]]; then
                integrity_failure \
                    "unpatched-priming-summary: ${context}/${artifact} rows=${row_count} expected=1"
                contract_failed=1
            fi
            if [[ "${#row_value}" -ne 64 || \
                "${row_value}" == *[!0123456789abcdef]* ]]; then
                integrity_failure \
                    "unpatched-priming-summary: ${context}/${artifact} is not lowercase 64-hex"
                contract_failed=1
            elif [[ "${row_value}" != "${summary_value}" ]]; then
                integrity_failure \
                    "unpatched-priming-summary: ${context}/${artifact} differs from summary"
                contract_failed=1
            fi
        done
    done

    if [[ "${contract_failed}" -eq 0 ]]; then
        printf 'CONTRACT PASS unpatched-priming-summary artifacts=4\n'
    else
        printf 'CONTRACT FAIL unpatched-priming-summary\n'
    fi
}

verify_corpus() {
    local label="$1"
    local fixture_table="$2"
    local report_subdir="$3"
    local expected_cases="$4"
    local expected_records="$5"
    local id
    local expected_rows
    local engine
    local relative
    local baseline
    local actual_rows
    local cases=0
    local records=0
    local corpus_failed=0
    local -a engines=(modern arndt64 gwdac)

    if ! check_tracked_file "${fixture_table}"; then
        printf 'CORPUS  FAIL %-28s fixture table unavailable\n' "${label}"
        return
    fi

    while IFS=$'\t' read -r id expected_rows; do
        baseline="${outputs_root}/phase2/reports/${report_subdir}/modern/${id}.results.tsv"
        for engine in "${engines[@]}"; do
            relative="phase2/reports/${report_subdir}/${engine}/${id}.results.tsv"
            if ! check_tracked_file "${relative}"; then
                corpus_failed=1
                continue
            fi
            if ! cmp -s "${baseline}" "${outputs_root}/${relative}"; then
                integrity_failure "${label}: ${engine}/${id} differs from modern"
                corpus_failed=1
            fi
            actual_rows="$(($(wc -l <"${outputs_root}/${relative}") - 1))"
            if [[ "${actual_rows}" -ne "${expected_rows}" ]]; then
                integrity_failure \
                    "${label}: ${engine}/${id} rows=${actual_rows} expected=${expected_rows}"
                corpus_failed=1
            fi
        done
        cases=$((cases + 1))
        records=$((records + expected_rows))
    done < <(
        awk -F '\t' 'NR > 1 {print $1 "\t" $12}' \
            "${outputs_root}/${fixture_table}"
    )

    if [[ "${cases}" -ne "${expected_cases}" || \
        "${records}" -ne "${expected_records}" ]]; then
        integrity_failure \
            "${label}: cases=${cases}/${expected_cases} records=${records}/${expected_records}"
        corpus_failed=1
    fi

    if [[ "${corpus_failed}" -eq 0 ]]; then
        printf 'CORPUS  PASS %-28s cases=%s records=%s engines=3\n' \
            "${label}" "${cases}" "${records}"
        pass_count=$((pass_count + 1))
    else
        printf 'CORPUS  FAIL %-28s cases=%s records=%s\n' \
            "${label}" "${cases}" "${records}"
    fi
}

readonly manifest_config='reviewer/config/evidence-manifests.tsv'
if check_tracked_file "${manifest_config}"; then
    while IFS=$'\t' read -r label base manifest; do
        if [[ "${label}" == label ]]; then
            continue
        fi
        verify_manifest "${label}" "${base}" "${manifest}"
	done <"${outputs_root}/${manifest_config}"
fi

readonly runtime_refresh_config='reviewer/config/runtime-refresh-packages.tsv'
if check_tracked_file "${runtime_refresh_config}"; then
	while IFS=$'\t' read -r label engine base manifest checkpoint; do
		if [[ "${label}" == label ]]; then
			continue
		fi
		verify_manifest "${label}" "${base}" "${manifest}"
		verify_runtime_refresh_package \
			"${label}" "${engine}" "${base}" "${manifest}" "${checkpoint}"
	done <"${outputs_root}/${runtime_refresh_config}"
verify_runtime_refresh_aggregate_contract "${runtime_refresh_config}"
fi

if ! "${script_root}/verify-evidence-sort-policy"; then
	integrity_failure 'evidence-sort-policy rejected the committed scripts'
fi

if ! "${script_root}/verify-cm12-harness-contract"; then
	integrity_failure 'CM12 harness contract rejected the committed scripts'
fi

if ! "${script_root}/verify-checkpoint3a-contract"; then
	integrity_failure 'checkpoint 3A contract rejected committed evidence'
fi

verify_unpatched_priming_summary

verify_corpus \
    cm12-dsg \
    phase2/fixtures/corpus.tsv \
    corpus \
    11 \
    138
verify_corpus \
    cm12-amplitude \
    phase2/fixtures/amplitudes/corpus.tsv \
    amplitude-corpus \
    13 \
    150

git -C "${outputs_root}" status --porcelain=v1 --untracked-files=all \
    >"${after_status}"
if ! cmp -s "${before_status}" "${after_status}"; then
    integrity_failure 'verifier changed the working-tree status'
fi

if [[ "${integrity_failures}" -ne 0 ]]; then
	printf 'RESULT evidence_integrity_fail failures=%s exit=%s commit=%s\n' \
		"${integrity_failures}" "${REVIEWER_EXIT_EVIDENCE_INTEGRITY}" \
		"${commit}"
	exit "${REVIEWER_EXIT_EVIDENCE_INTEGRITY}"
fi

printf 'RESULT pass packages=%s exit=%s commit=%s\n' \
	"${pass_count}" "${REVIEWER_EXIT_SUCCESS}" "${commit}"
