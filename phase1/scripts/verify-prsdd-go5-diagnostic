#!/usr/bin/env bash
set -euo pipefail

readonly script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly workspace="${GO5_CANDIDATE_WORKSPACE:-$(mktemp -d "${TMPDIR:-/tmp}/gwdac-go5-determinism.XXXXXX")}"
readonly candidate_a="${workspace}/kiritimati"
readonly candidate_b="${workspace}/gmt-minus-12"
readonly keep_workspace="${GO5_KEEP_WORKSPACE:-0}"

cleanup() {
    if [[ "${keep_workspace}" == 1 ]]; then
        printf 'GO5 candidate workspace retained: %s\n' "${workspace}"
    else
        rm -rf "${workspace}"
    fi
}
trap cleanup EXIT

mkdir -p "${workspace}"
"${script_root}/run-prsdd-go5-candidate" \
    "${candidate_a}" Pacific/Kiritimati
"${script_root}/run-prsdd-go5-candidate" \
    "${candidate_b}" Etc/GMT+12
"${script_root}/compare-prsdd-go5-runs" \
    "${candidate_a}" "${candidate_b}" "${workspace}/two-run-comparison.tsv"

printf 'prsdd GO5 evidence-determinism seam: CANDIDATE PASS workspace=%s\n' \
    "${workspace}"
