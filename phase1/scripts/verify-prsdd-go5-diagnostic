#!/usr/bin/env bash
set -euo pipefail

readonly script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly outputs_root="$(cd "${script_root}/../.." && pwd)"
readonly compose_root="${outputs_root}/container-environment"
readonly report_root="${outputs_root}/phase1/reports/prsdd-go5-diagnostic"

docker compose -f "${compose_root}/compose.yaml" up -d dev oracle
docker compose -f "${compose_root}/compose.yaml" exec -T dev bootstrap-repos

if ! docker compose -f "${compose_root}/compose.yaml" exec -T dev \
    test -x /workspace/phase1/reproducible/artifacts/f6c81d01a1fe/prsdd-headless; then
    docker compose -f "${compose_root}/compose.yaml" exec -T dev \
        /phase1/scripts/build-prsdd
fi

docker compose -f "${compose_root}/compose.yaml" exec -T dev \
    env REUSE_DIAGNOSTIC_BUILDS=yes \
    /phase1/scripts/run-prsdd-go5-diagnostic
docker compose -f "${compose_root}/compose.yaml" exec -T oracle \
    /phase1/scripts/run-historical-prsdd-go5-diagnostic

(
    cd "${report_root}"
    sha256sum -c manifest.sha256
)

printf 'prsdd GO5 diagnostic: PASS\n'
