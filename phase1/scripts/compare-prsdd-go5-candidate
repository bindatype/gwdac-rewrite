#!/usr/bin/env perl
use strict;
use warnings;

use Digest::SHA qw(sha256_hex);
use File::Basename qw(dirname);
use File::Spec;

sub usage {
    die "usage: $0 CANDIDATE_PACKAGE CANDIDATE_MANIFEST REFERENCE_PACKAGE REPORT\n";
}

sub slurp {
    my ($path) = @_;
    open my $fh, '<:raw', $path or die "cannot read $path: $!\n";
    local $/;
    return <$fh>;
}

sub hash_file {
    my ($path) = @_;
    return sha256_hex(slurp($path));
}

sub read_manifest {
    my ($path) = @_;
    my %entries;
    for my $line (split /\n/, slurp($path)) {
        next unless length $line;
        my ($hash, $relative) = $line =~ /^([0-9a-f]{64})  (.+)$/
            or die "invalid manifest row in $path: $line\n";
        die "duplicate manifest path in $path: $relative\n" if exists $entries{$relative};
        $entries{$relative} = $hash;
    }
    return %entries;
}

@ARGV == 4 or usage();
my ($candidate_root, $candidate_manifest, $reference_root, $report) = @ARGV;
my $script_root = dirname(File::Spec->rel2abs($0));
my $inventory_path = $ENV{EVIDENCE_INVENTORY} // $ENV{GO5_INVENTORY}
    // File::Spec->catfile($script_root, '..', 'config', 'prsdd-go5-generated-files.txt');
my @inventory = grep { length } map { chomp; $_ } split /\n/, slurp($inventory_path);
my %inventory = map { $_ => 1 } @inventory;
my %candidate = read_manifest($candidate_manifest);
my %reference = read_manifest(File::Spec->catfile($reference_root, 'manifest.sha256'));

die "candidate manifest does not match explicit inventory\n"
    if join("\n", sort keys %candidate) ne join("\n", sort @inventory);

my %counts;
my @rows = ("path\trelation\tcandidate_sha256\treference_sha256");
for my $relative (@inventory) {
    my $candidate_path = File::Spec->catfile($candidate_root, split m{/}, $relative);
    my $actual = hash_file($candidate_path);
    die "candidate manifest mismatch: $relative\n" if $actual ne $candidate{$relative};

    my ($relation, $reference_hash);
    if (!exists $reference{$relative}) {
        $relation = 'candidate-only-explicit';
        $reference_hash = '-';
    } else {
        my $reference_path = File::Spec->catfile($reference_root, split m{/}, $relative);
        die "reference file missing: $relative\n" unless -f $reference_path;
        die "committed reference manifest mismatch: $relative\n"
            if hash_file($reference_path) ne $reference{$relative};
        $reference_hash = $reference{$relative};
        $relation = $actual eq $reference_hash ? 'raw-exact' : 'raw-different';
    }
    $counts{$relation}++;
    push @rows, join("\t", $relative, $relation, $actual, $reference_hash);
}

for my $relative (sort keys %reference) {
    next if $inventory{$relative};
    $counts{'reference-document-only'}++;
    push @rows, join("\t", $relative, 'reference-document-only', '-', $reference{$relative});
}

open my $fh, '>:raw', $report or die "cannot write $report: $!\n";
print {$fh} join("\n", @rows), "\n";
close $fh or die "cannot close $report: $!\n";
printf "candidate comparison: raw_exact=%d raw_different=%d candidate_only=%d reference_document_only=%d\n",
    map { $counts{$_} // 0 }
    qw(raw-exact raw-different candidate-only-explicit reference-document-only);
