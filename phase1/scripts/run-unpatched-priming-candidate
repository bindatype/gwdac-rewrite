#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'usage: %s ABSOLUTE_CANDIDATE_ROOT TIME_ZONE\n' "$0" >&2
    exit 64
}

[[ "$#" -eq 2 ]] || usage
readonly candidate_root="$1"
readonly evidence_tz="$2"
readonly script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly outputs_root="$(cd "${script_root}/../.." && pwd)"
readonly compose_file="${outputs_root}/container-environment/compose.yaml"
readonly reference_root="${outputs_root}/phase1/reports/unpatched-priming-measurement"
readonly raw_root="${candidate_root}/raw/unpatched-priming-measurement"
readonly canonical_root="${candidate_root}/canonical/unpatched-priming-measurement"
readonly inventory="${outputs_root}/phase1/config/unpatched-priming-generated-files.txt"
readonly date_fields="${outputs_root}/phase1/config/unpatched-priming-date-fields.tsv"
readonly project="gwdac-unpatched-priming-candidate-$$"
readonly before_fingerprint="$(mktemp)"
readonly after_fingerprint="$(mktemp)"
runtime_started=0
completed=0

case "${candidate_root}" in
    /*) ;;
    *) usage ;;
esac
case "${candidate_root}/" in
    "${outputs_root}/"*)
        printf 'candidate root must be outside the authoritative worktree\n' >&2
        exit 64
        ;;
esac
if [[ -e "${candidate_root}" ]]; then
    printf 'candidate root already exists: %s\n' "${candidate_root}" >&2
    exit 64
fi

fingerprint_worktree() {
    local output="$1"
    find "${outputs_root}" \
        -path "${outputs_root}/.git" -prune -o \
        -type f -exec shasum -a 256 {} \; \
        | LC_ALL=C sort >"${output}"
}

compose() {
    PHASE1_REPORTS_HOST="${candidate_root}" \
        docker compose -p "${project}" -f "${compose_file}" "$@"
}

cleanup() {
    if [[ "${runtime_started}" -eq 1 ]]; then
        compose down --volumes >/dev/null 2>&1 || true
    fi
    rm -f "${before_fingerprint}" "${after_fingerprint}"
    if [[ "${completed}" -eq 0 ]]; then
        printf 'unpatched-priming candidate failed; partial capture retained at %s\n' \
            "${candidate_root}" >&2
    fi
}
trap cleanup EXIT

fingerprint_worktree "${before_fingerprint}"
mkdir -p "${candidate_root}/raw" "${candidate_root}/scratch"
cat >"${candidate_root}/run-context.txt" <<EOF
evidence_label=captured
outputs_commit=$(git -C "${outputs_root}" rev-parse HEAD)
time_zone=${evidence_tz}
candidate_root=${candidate_root}
accepted_evidence_modified=no
execution_state=disposable_docker_volumes
physics_review=pending
EOF

compose up -d --build dev
runtime_started=1
compose exec -T dev bootstrap-repos
compose exec -T dev \
    env \
    PRRDX_PATCH_MODE=skip \
    PHASE1_STATE_ROOT=/workspace/phase1/prsdd-go5-diagnostic/unpatched \
    PHASE1_REPORT_ROOT=/phase1/reports/scratch/unpatched-build \
    /phase1/scripts/build-prsdd
compose exec -T dev \
    env \
    EVIDENCE_TZ="${evidence_tz}" \
    PHASE1_REPORT_ROOT=/phase1/reports/raw \
    PRSD_GO5_STATE_ROOT=/workspace/phase1/prsdd-go5-diagnostic \
    /phase1/scripts/run-unpatched-priming-measurement

EVIDENCE_INVENTORY="${inventory}" EVIDENCE_PACKAGE_LABEL='unpatched priming' \
    "${script_root}/write-evidence-manifest" \
    "${raw_root}" "${candidate_root}/raw-manifest.sha256"
EVIDENCE_INVENTORY="${inventory}" EVIDENCE_DATE_FIELDS="${date_fields}" \
    "${script_root}/canonicalize-prsdd-go5-evidence" \
    "${raw_root}" "${canonical_root}" "${candidate_root}/canonicalization.tsv"
EVIDENCE_INVENTORY="${inventory}" EVIDENCE_PACKAGE_LABEL='unpatched priming' \
    "${script_root}/write-evidence-manifest" \
    "${canonical_root}" "${candidate_root}/canonical-manifest.sha256"
EVIDENCE_INVENTORY="${inventory}" \
    "${script_root}/compare-prsdd-go5-candidate" \
    "${raw_root}" \
    "${candidate_root}/raw-manifest.sha256" \
    "${reference_root}" \
    "${candidate_root}/candidate-vs-committed.tsv"

test "$(awk -F '\t' 'NR > 1 && $2 == "raw-exact" { count++ } END { print count + 0 }' \
    "${candidate_root}/candidate-vs-committed.tsv")" -eq 10
test "$(awk -F '\t' 'NR > 1 && $2 == "raw-different" { count++ } END { print count + 0 }' \
    "${candidate_root}/candidate-vs-committed.tsv")" -eq 0
test "$(awk -F '\t' 'NR > 1 && $1 == "README.md" && $2 == "reference-document-only" { count++ } END { print count + 0 }' \
    "${candidate_root}/candidate-vs-committed.tsv")" -eq 1

rm -rf "${candidate_root}/scratch"
fingerprint_worktree "${after_fingerprint}"
if ! cmp -s "${before_fingerprint}" "${after_fingerprint}"; then
    printf 'unpatched-priming candidate changed a path outside candidate root\n' >&2
    diff -u --label before-worktree --label after-worktree \
        "${before_fingerprint}" "${after_fingerprint}" >&2 || true
    exit 30
fi

completed=1
printf 'unpatched-priming candidate captured: root=%s timezone=%s generated_files=10 reference_files=1\n' \
    "${candidate_root}" "${evidence_tz}"
