#!/usr/bin/env bash
set -euo pipefail

readonly script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly outputs_root="$(cd "${script_root}/../.." && pwd)"
readonly compose="${outputs_root}/container-environment/compose.yaml"
readonly report_root="${outputs_root}/phase1/reports/unpatched-priming-measurement"
readonly binary='/workspace/phase1/prsdd-go5-diagnostic/unpatched/artifacts/f6c81d01a1fe/prsdd-headless'

docker compose -f "${compose}" up -d dev
docker compose -f "${compose}" exec -T dev bootstrap-repos

if ! docker compose -f "${compose}" exec -T dev test -x "${binary}"; then
    docker compose -f "${compose}" exec -T dev \
        env PRRDX_PATCH_MODE=skip \
            PHASE1_STATE_ROOT=/workspace/phase1/prsdd-go5-diagnostic/unpatched \
            PHASE1_REPORT_ROOT=/workspace/phase1/unpatched-priming-build \
            /phase1/scripts/build-prsdd
fi

docker compose -f "${compose}" exec -T dev \
    /phase1/scripts/run-unpatched-priming-measurement

(
    cd "${report_root}"
    sha256sum -c manifest.sha256
)

printf 'unpatched priming measurement: PASS\n'
printf 'compatibility gate: FAIL (captured post-output PRRDX EOF, exit 2)\n'
