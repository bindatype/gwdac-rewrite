#!/usr/bin/env bash
set -euo pipefail

readonly source_root="${ARNDT64_SOURCE:-/workspace/arndt64}"
readonly state_root="${PHASE1_STATE_ROOT:-/workspace/phase1/reproducible}"
readonly phase1_root="${PHASE1_ROOT:-/phase1}"
readonly report_root="${PHASE1_REPORT_ROOT:-${phase1_root}/reports}"
readonly short_commit="$(git -C "${source_root}" rev-parse --short=12 HEAD)"
readonly executable="${state_root}/artifacts/${short_commit}/pnpolw"
readonly request_fixture="${phase1_root}/fixtures/pnpol-request.in"
readonly interactive_fixture="${phase1_root}/fixtures/pnpol-interactive.inp"
readonly run_root="$(mktemp -d "${state_root}/pnpolw-run.XXXXXX")"

normalize_dates() {
    perl -pe 's{\b\d{1,2}/\s*\d{1,2}/\s*\d{1,2}\b}{<DATE>}g' "$1"
}

mkdir -p "${run_root}/data" "${report_root}"
cp "${executable}" "${run_root}/pnpolw"
cp "${request_fixture}" "${run_root}/PNPOL.IN"
cp "${interactive_fixture}" "${run_root}/PNPOL.INP"
cp \
    "${source_root}/sdat/"{pnintp,ka84,karls,karlc,pnsol,pnses,polzer}.dat \
    "${run_root}/data/"

set +e
(
    cd "${run_root}"
    ./pnpolw <PNPOL.INP >stdout 2>stderr
)
status=$?
set -e

printf '%s\n' "${status}" >"${report_root}/pnpol-modern.exit"
cp "${run_root}/stdout" "${report_root}/pnpol-modern.stdout"
cp "${run_root}/stderr" "${report_root}/pnpol-modern.stderr"
cp "${run_root}/PNPOL.PCT" "${report_root}/pnpol-modern.PNPOL.PCT"
cp "${run_root}/PNPOL.TMP" "${report_root}/pnpol-modern.PNPOL.TMP"
normalize_dates "${run_root}/stdout" \
    >"${report_root}/pnpol-modern.normalized.stdout"
normalize_dates "${run_root}/PNPOL.PCT" \
    >"${report_root}/pnpol-modern.normalized.PNPOL.PCT"

{
    printf 'exit=%s\n' "${status}"
    printf 'request_fixture_sha256=%s\n' "$(sha256sum "${request_fixture}" | awk '{print $1}')"
    printf 'interactive_fixture_sha256=%s\n' "$(sha256sum "${interactive_fixture}" | awk '{print $1}')"
    printf 'data_files=7\n'
    printf 'data_sha256:\n'
    (
        cd "${run_root}"
        sha256sum data/*.dat
    )
    printf 'outputs_sha256:\n'
    sha256sum \
        "${report_root}/pnpol-modern.normalized.stdout" \
        "${report_root}/pnpol-modern.normalized.PNPOL.PCT" \
        "${report_root}/pnpol-modern.PNPOL.TMP"
} >"${report_root}/pnpol-modern-manifest.txt"

if [[ "${status}" -ne 0 ]]; then
    printf 'pnpolw failed with exit %s\n' "${status}" >&2
    exit "${status}"
fi

if [[ -s "${run_root}/stderr" ]]; then
    printf 'pnpolw emitted stderr\n' >&2
    exit 1
fi

printf 'Modern pnpolw reports written to %s\n' "${report_root}"
