#!/usr/bin/env bash
set -euo pipefail

readonly phase1_root="${PHASE1_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
readonly package_root="${phase1_root}/reports/runtime-refresh/pnsd"
readonly manifest="${package_root}/evidence-manifest.sha256"

mapfile -t report_files < <(
    find "${package_root}" -type f ! -name evidence-manifest.sha256 -print \
        | sort
)

files=(
    "${phase1_root}/README.md"
    "${phase1_root}/fixtures/pnsd-sp06-no-render.in"
    "${phase1_root}/reports/warning-register.md"
    "${phase1_root}/scripts/build-pnsd"
    "${phase1_root}/scripts/run-historical-pnsd"
    "${phase1_root}/scripts/run-pnsd"
    "${phase1_root}/scripts/write-pnsd-evidence-manifest"
    "${report_files[@]}"
)

(
    cd "${phase1_root}"
    for file in "${files[@]}"; do
        sha256sum "${file#${phase1_root}/}"
    done
) >"${manifest}"

printf 'Wrote pnsd evidence manifest: %s files=%s\n' \
    "${manifest}" "${#files[@]}"
